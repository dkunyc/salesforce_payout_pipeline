# Salesforce credentials (do not commit real values)
# Preferred: use environment variables or a secrets.toml

[sources.salesforce]
username = "your-username@company.com"
password = "your-password"
security_token = "your-security-token"

# Or OAuth / Connected App (recommended for production)
# client_id = "..."
# client_secret = "..."
# refresh_token = "..."

# NetSuite (token-based or OAuth)
[netsuite]
access_token = "your-netsuite-bearer-token"
# account_id is interpolated in the pipeline base_url
